{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun run generate-routes && vite build",
    "check-types": "bun run generate-routes && tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "bunx --bun drizzle-kit generate && bun run db:flatten",
    "db:flatten": "bun run scripts/flatten-migrations.ts",
    "db:migrate:local": "wrangler d1 migrations apply artifacts-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply artifacts-db --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/drizzle-adapter": "^1.6.18",
    "@effect/sql-d1": "catalog:",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@posthog/react": "^1.10.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "catalog:",
    "files-sdk": "^2.2.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.4",
    "lucide-react": "^1.18.0",
    "nitro": "^3.0.260610-beta",
    "posthog-js": "^1.396.6",
    "posthog-node": "^5.39.4",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "shadcn": "^4.11.0",
    "srvx": "^0.11.17",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.124.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
