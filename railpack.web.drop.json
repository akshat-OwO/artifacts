{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "bun": "1.3.14",
    "node": "24"
  },
  "steps": {
    "build": {
      "commands": ["test -f apps/web/.output/server/index.mjs"]
    }
  },
  "deploy": {
    "startCommand": "bun --cwd apps/web db:migrate && bun --cwd apps/web start"
  }
}
